# Copy to .env and fill in. setup.sh does this for you.

# Your domain, pointed at this server (A record). Only used with Caddy.
DOMAIN=example.com

# Anyone who opens the proxy must type this once. Leave empty to turn the
# lock off (not recommended: an open proxy gets abused, and abuse reports
# go to your Hetzner account).
ACCESS_KEY=

# Password for the private /stats/ page. Empty = the page is off
# (visits are still counted).
STATS_KEY=
