# Copy to .env and fill in. setup.sh does this for you.

# Your domain, pointed at this server (A record). Only used with Caddy.
DOMAIN=example.com

# Anyone who opens the proxy must type this once. Leave empty to turn the
# lock off (not recommended: an open proxy gets abused, and abuse reports
# go to your Hetzner account).
ACCESS_KEY=

# Password for the private /stats/ page. Empty = the page is off
# (visits are still counted).
STATS_KEY=

# Wakes the ghost (the hidden AI page, /ghost/). Empty = it stays asleep.
# Billed to your Anthropic account; never commit the real value.
ANTHROPIC_API_KEY=
# Model id for the ghost. Empty = claude-haiku-5-5.
AI_MODEL=
# Ghost requests per day for all visitors together (cost cap).
AI_DAILY_MAX=300

# The weekly signal (docs/07-hunt.md). tools/hunt-keys.mjs creates these three; without
# them the hunt is simply off and the rest of the site is unaffected. HUNT_SEED does NOT
# belong here: it lives only in hunt/seal.env on the machine that seals content.
HUNT_KEY=
HUNT_HMAC=
HUNT_SIGN_KEY=
# Optional: HUNT_PACK_DIR (default server/hunt), HUNT_DATA_DIR (default <STATS_DIR>/hunt).
