# Copy this file to .env (same folder) and fill in your key.
# .env is ignored by git, so the key never ends up in the repo.

# Your Anthropic API key (console.anthropic.com -> API keys).
ANTHROPIC_API_KEY=

# Optional settings:
# KYRIE_MODEL=claude-opus-5-5     # or claude-sonnet-5-5 / claude-haiku-5-5 (cheaper)
# KYRIE_DAILY_MAX=150             # most decks Claude makes per day, for everyone together
# KYRIE_PORT=8130
# KYRIE_HOST=127.0.0.1            # 0.0.0.0 to accept connections from other machines
