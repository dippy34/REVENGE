# COEP "credentialless" on games/ and semag/ makes the page cross-origin isolated,
# which Godot and threaded Unity games need (SharedArrayBuffer). Cross-origin
# images and scripts still load; they are just fetched without cookies.
#
# semag/ is the R2 games, relayed by server.mjs (semag.mjs). Like games/play.html
# it runs third-party game code, so it gets the loose CSP; it is framed only by
# games/index.html. vendor/ is Ruffle, loaded by the Flash games.
/semag/*
  Content-Security-Policy: default-src 'self' data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' blob: data: https:; style-src 'self' 'unsafe-inline' https: data:; img-src 'self' https: data: blob:; font-src 'self' https: data:; media-src 'self' https: data: blob:; connect-src 'self' https: data: blob: wss:; worker-src 'self' blob: data:; frame-src 'self' https: data: blob:; object-src 'none'; base-uri 'self' https:; frame-ancestors 'self'
